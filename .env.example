# Copy to .env for local development. Everything is optional, see the README for details.

# Server
# Public URL of the app. Set it in production, forms fail without it behind a reverse proxy.
# ORIGIN=https://dash.example.com
# PORT=3000
# HOST=0.0.0.0
# DB_FILE_NAME=data/db.sqlite

# Docker only: the uid/gid the server runs as. The data volume is chowned to match on startup.
# PUID=10001
# PGID=10001

# Sign-in with OpenID Connect. Setting OIDC_ISSUER turns it on, then the client id and secret are
# required. Register the redirect URL <ORIGIN>/auth/callback with your provider.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=bercail
# OIDC_CLIENT_SECRET=
# Comma-separated. Unset lets in anyone the provider signs in.
# OIDC_ALLOWED_EMAILS=me@example.com

# Weather. A location picked in Settings takes precedence over these.
# WEATHER_LAT=48.8566
# WEATHER_LON=2.3522
# WEATHER_LOCATION_NAME=Home
# celsius or fahrenheit
# WEATHER_UNITS=celsius

# Filesystem the disk gauge reports on. Defaults to /System/Volumes/Data on macOS, / elsewhere.
# DISK_STATS_PATH=/
