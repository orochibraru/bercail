{
	"name": "bercail",
	"private": true,
	"version": "1.0.9",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"build:extension": "vite build -c extension/vite.config.ts",
		"package:extension": "bun run build:extension && cd dist/extension && rm -f ../bercail-extension.zip && zip -qr ../bercail-extension.zip .",
		"prepare": "svelte-kit sync || echo '' && prek install --allow-missing-config || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write --unsafe .",
		"test": "svelte-kit sync && bun test",
		"screenshots": "playwright test --config playwright.screenshots.config.ts",
		"sync": "svelte-kit sync",
		"format": "biome format --write . && prettier --log-level warn --write \"src/**/*.svelte\" \"**/*.md\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@crxjs/vite-plugin": "^2.7.1",
		"@internationalized/date": "^3.12.4",
		"@j178/prek": "^0.5.3",
		"@kitql/helpers": "^0.8.15",
		"@lucide/svelte": "^1.47.0",
		"@orochibraru/svelte-smol": "^1.7.0-next.3",
		"@playwright/test": "^1.62.1",
		"@sveltejs/kit": "^3.0.0-next.27",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/chrome": "^0.3.0",
		"@types/node": "^26.6.1",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"postcss": "^8.5.28",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"overrides": {
		"typebox": "1.2.19"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"mode-watcher": "^1.1.0",
		"openid-client": "^6.8.8",
		"svelte-dnd-action": "^0.9.79",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.5"
	}
}
